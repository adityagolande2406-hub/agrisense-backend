# AgriSense Backend Environment Configuration
# Copy to .env and fill in real values

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://agrisense:agrisense@localhost:5432/agrisense_db

# Security
SECRET_KEY=change-this-to-a-strong-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Feature flags
USE_MOCK_INFERENCE=true  # true = mock AI; false = real inference service

# Inference service (only used when USE_MOCK_INFERENCE=false)
# This is the URL of your separate AI inference microservice
INFERENCE_SERVICE_URL=http://localhost:8001/infer
INFERENCE_TIMEOUT_SECONDS=60

# Severity config (external — do NOT hardcode thresholds)
# Thresholds are loaded from here so they can be tuned without code changes
SEVERITY_HIGH_THRESHOLD=60.0
SEVERITY_MEDIUM_THRESHOLD=30.0

# App
APP_ENV=development
APP_NAME=AgriSense
CORS_ORIGINS=["*"]
